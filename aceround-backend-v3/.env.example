# ==============================
# AceRound Backend — Environment
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ==============================

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (Vite dev server) — used for CORS + cookie sameSite settings
FRONTEND_URL=http://localhost:3400

# MongoDB
# Local:  mongodb://127.0.0.1:27017/aceround
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aceround
MONGO_URI=mongodb://127.0.0.1:27017/aceround

# Auth
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=aceround_token

# ------------------------------------------------------------------
# AI question generation
# Set AI_PROVIDER to "gemini", "openai", "groq", or "none".
# If the key for the chosen provider is missing, or the call fails,
# the server automatically falls back to the static local question bank
# so the app never breaks.
#
# Recommended free option: groq (no credit card, very fast, generous free tier)
# ------------------------------------------------------------------
AI_PROVIDER=groq

# Google Gemini (https://aistudio.google.com/apikey) — free tier, but the
# newest models can be temporarily overloaded (503 errors) right after launch.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI — paid, requires billing (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Groq — free, no credit card required (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Interview settings
INTERVIEW_TIME_LIMIT_SECONDS=900
DEFAULT_QUESTION_COUNT=20

# ------------------------------------------------------------------
# OAuth (optional) — "Continue with Google/GitHub" login buttons.
# Leave blank to disable; the app works fine with just email/password.
# ------------------------------------------------------------------

# Google Cloud Console (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub Developer Settings (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
